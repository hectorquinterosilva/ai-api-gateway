services:

  postgres:
    image: postgres:18

    container_name: ai_gateway_postgres

    environment:
      POSTGRES_DB: ai_gateway
      POSTGRES_USER: postgres
      POSTGRES_PASSWORD: postgres

    ports:
      - "5432:5432"

    volumes:
      - postgres_data:/var/lib/postgresql/data

  redis:
    image: redis:8

    container_name: ai_gateway_redis

    ports:
      - "6379:6379"

volumes:
  postgres_data:
